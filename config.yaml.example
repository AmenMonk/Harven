# config.yaml.example
# 复制本文件为 config.yaml，并按需修改
# DO NOT commit config.yaml to git (contains passwords)

ai:
  temperature: 0.7
app:
  language: zh-CN
  name: Harven AI
  version: 0.1.0
hardware:
  advanced_vram_gb: 12
  min_ram_gb: 16
  min_vram_gb: 6
independence:
  allowed_domains:
  - ollama.ai
  - huggingface.co
  - modelscope.cn
  # ── 外部大模型 API（按需启用，不用的可以删掉）──
  - api.deepseek.com
  - dashscope.aliyuncs.com
  - api.moonshot.cn
  - ark.cn-beijing.volces.com
  - api.openai.com
  - api.anthropic.com
  - generativelanguage.googleapis.com
  - api.groq.com
  - api.mistral.ai
  - api.cohere.ai
  - api.siliconflow.cn
  - openrouter.ai
  - api.hunyuan.cloud.tencent.com
  - api.baichuan-ai.com
  - open.bigmodel.cn
  - api.lingyiwanwu.com
  - api.stepfun.com
  - api.minimaxi.chat
  - qianfan.baidubce.com
  - spark-api-open.xf-yun.com
  - sky-api.singularity-ai.com
  - api-inference.huggingface.co
  - api.x.ai
  - api.perplexity.ai
  - api.together.xyz
  # ── 联网搜索 ──
  - cn.bing.com
  - html.duckduckgo.com
  - api.exa.ai
  - hq.sinajs.cn
  - finance.sina.com.cn
  # ── 更新检查 ──
  - harvenhub.com
  blocked_protocols:
  - gRPC集群
  - 分布式张量
language:
  main_language: zh-CN
  other_language_mode: translate
  ui_language: follow
memory:
  snapshot_interval: 5
  working_context_turns: 8
morality:
  answer_style: friend
  conflict_mode: direct
  lockdown_threshold: 3
  lockdown_triggers:
  - 制造危险物品
  - 恐怖袭击
  - 反人类
  morality_level: default
  show_reminders: true
  show_thinking: false
  warn_triggers:
  - 伤害他人
  - 欺骗
  - 造假
ollama:
  base_url: http://localhost:11434
  default_model: ""
  model_scheduling: auto
  models:
  - desc: 日常对话、快速响应
    model_id: qwen2.5:7b
    name: Qwen2.5-7B（轻量）
    speed: 25-40字/秒
    vram: 5GB
  - desc: 深度思考、复杂推理
    model_id: qwen2.5:14b
    name: Qwen2.5-14B（推荐）
    speed: 10-20字/秒
    vram: 10GB
  - desc: 深度推理、技术分析
    model_id: deepseek-r1:14b
    name: DeepSeek-R1-Distill-14B
    speed: 8-15字/秒
    vram: 9GB
  reasoning_mode: fast
security:
  admin_password: CHANGE_ME_ON_FIRST_RUN
  antivirus_enabled: false
  antivirus_path: ''
  auto_lock_minutes: 0
  privacy_password: 
storage:
  config: data/config/
  conversations: data/conversations/
  faiss: data/faiss/
  knowledge: data/knowledge/
  snapshots: data/snapshots/
  sqlite: data/sqlite/lingzhi.db
# HarvenHub 云端社区市场地址
harvenhub_server_url: "https://harvenhub.com"
ui:
  bubble_style: default
  font_size: medium
  theme: system
user:
  answer_preference: detailed
  avatar: ''
  interests: []
  nickname: ''
  profession: ''
web_search:
  auto_search: true
  default_query_mode: auto
  enabled: true
  search_engine: bing
