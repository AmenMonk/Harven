.workbuddy/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# === Windows 保留文件名（无法删除，只能排除）===
NUL
NULL

# === 规则修正：根目录测试脚本不进，tests/ 目录要进 ===
/test_*.py

# ★ #1524 数据主权：data 全目录默认不入库，仅白名单内置资产例外
data/*
!data/config/
!data/conversations/
!data/faiss/
!data/fc_wrappers/
!data/builtin_skills/
!data/attributions.json
data/faiss/*
!data/faiss/.gitkeep
data/conversations/*
!data/conversations/.gitkeep
# 一次性脚本/输出
/_*.txt
/_test_*.py
/_smoke_*.py
/check_*.py
/tmp_*.py
/_repro*
