# HarvenAI .gitignore — 2026-11-16 仓库大扫除定版
# 原则：仓库只进「代码 + 文档 + 出厂模板」；运行时/模型/用户数据/安装包一律不进

# === 敏感文件（最高优先）===
config.yaml
config.yaml.bak*
config.example.yaml.bak
*.env
.env
data/multi_models.json
data/multi_models.example.json

# === 大体积运行时 / 依赖 ===
.venv/
venv/
python/
spa/node_modules/
node_modules/
packer_assets/
_wheels_full/

# === 模型权重（20G+，用 Release/HarvenHub 分发）===
data/models/
*.gguf
*.onnx
*.safetensors
*.bin

# === 用户数据 / 运行时数据 ===
data/media/
data/downloads/
data/sqlite/
data/backups/
data/logs/
data/snapshots/
data/tool_results/
data/exports/
data/isolated_dbs/
data/vision/
data/tmp/
data/reports/
data/knowledge/*.faiss
data/knowledge/*.pkl
data/system_knowledge.json
data/discovered_models.json
data/device_binding.json
data/security_log.json
data/harven.log*

# === 打包 / 测试 / 一次性目录 ===
_package_staging/
_install_test_*/
_r4*_test*/
_r5*_test*/
_apk_*/
_apk_0929/
_innosetup/
_hotfix_laptop/
_diag_phone/
_dev_scripts/
archive/
build/
dist/
output/
check_reports/
installer_output/
downloads/

# === Python 产物 ===
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/

# === 打包产物（用 GitHub Release / HarvenHub 发布）===
*.zip
*.tar.gz
*.7z
*.exe
*.msi
*.apk

# === 日志 ===
*.log
logs/
flask_log.txt
flask_*.log
harven*.log
start_log*.txt

# === 坏档 / 备份尸体（2026-11-16 扫除清单）===
*.bak
*.orig
*broken_*
*_backup.py
main_pyside6_backup.py
web_app.py.broken_*
config.yaml.bak_python_tag
