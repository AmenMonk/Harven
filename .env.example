# Harven AI — 环境变量配置模板
# 复制此文件为 .env 并填入实际值（.env 不会被提交到 Git）

# ===== Ollama 配置 =====
# Ollama 服务地址（默认 localhost:11434）
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
# 默认模型
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# ===== 服务配置 =====
# Web 服务端口（默认 5000）
HARVEN_PORT=5000
# 绑定地址（默认 0.0.0.0 允许局域网访问）
HARVEN_HOST=0.0.0.0
# 调试模式（生产环境务必设为 false）
HARVEN_DEBUG=false

# ===== 安全配置 =====
# 管理员密码（留空则使用 config.yaml 中的默认值）
HARVEN_ADMIN_PASSWORD=

# ===== 可选：外部模型 API =====
# DeepSeek API Key（可选）
# DEEPSEEK_API_KEY=sk-xxxxxxxx
# Kimi API Key（可选）
# KIMI_API_KEY=sk-xxxxxxxx

# ===== 可选：Cloudflare Tunnel =====
# CLOUDFLARE_TUNNEL_TOKEN=your-token-here
